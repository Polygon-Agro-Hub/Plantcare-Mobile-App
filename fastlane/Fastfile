# fastlane/Fastfile

WORKSPACE_NAME = "GoviCare"
APP_IDENTIFIER = "com.polygonagro.GoviCare"

default_platform(:ios)

platform :ios do

  private_lane :get_api_key do
    app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house:              false
    )
  end

  private_lane :sync_certificates do |options|
    api_key = options[:api_key]

    match(
      type:                    "appstore",
      app_identifier:          APP_IDENTIFIER,
      git_url:                 ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly:                is_ci,
      api_key:                 api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id:               ENV["APPLE_TEAM_ID"],
      code_sign_identity:    "iPhone Distribution",
      targets:               [WORKSPACE_NAME],
      path:                  "ios/#{WORKSPACE_NAME}.xcodeproj",
      profile_name:          ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"],
      bundle_identifier:     APP_IDENTIFIER
    )
  end

  private_lane :build_ios_app do
    build_app(
      workspace:        "ios/#{WORKSPACE_NAME}.xcworkspace",
      scheme:           WORKSPACE_NAME,
      configuration:    "Release",
      export_method:    "app-store",
      clean:            true,
      output_directory: "./build",
      output_name:      "GoVi-Transport.ipa",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
        }
      }
      # ← xcargs removed entirely — it conflicts with Match manual signing
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci  # ← THIS IS THE KEY FIX — creates unlocked keychain on GitHub Actions

    api_key = get_api_key
    sync_certificates(api_key: api_key)

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/#{WORKSPACE_NAME}.xcodeproj"
    )

    build_ios_app

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         "Build #{build_number} — dev-main branch"
    )

    UI.success("✅ Build #{build_number} uploaded to TestFlight!")
  end

  desc "Build and upload to App Store"
  lane :release do
    setup_ci  # ← Same fix here

    api_key = get_api_key
    sync_certificates(api_key: api_key)

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/#{WORKSPACE_NAME}.xcodeproj"
    )

    build_ios_app

    upload_to_app_store(
      api_key:                           api_key,
      skip_metadata:                     true,
      skip_screenshots:                  true,
      submit_for_review:                 false,
      force:                             true,
      precheck_include_in_app_purchases: false
    )

    UI.success("✅ Build #{build_number} uploaded to App Store Connect!")
  end

end